; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Marea Negra"
run/main_scene="res://scenes/world/main_world.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

Viento="*res://scripts/mundo/viento.gd"
Ajustes="*res://scripts/mundo/ajustes.gd"
Oleaje="*res://scripts/mundo/oleaje.gd"
Horizonte="*res://scripts/mundo/horizonte.gd"
Origen="*res://scripts/mundo/origen.gd"

[display]

window/size/mode=3

[shader_globals]

origen_mundo={
"type": "vec2",
"value": Vector2(0, 0)
}
