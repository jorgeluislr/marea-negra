; El origen de la CharacterBody3D esta en el CENTRO de la capsula (0,9 sobre los pies), asi que
; el pivote va a 0,7 para tener los ojos a 1,6 m del suelo. Con 1,6 aqui se miraba desde 2,5 m.
[node name="CameraPivot" type="Node3D" parent="."]
position = Vector3(0, 0.7, 0)

; far: de fabrica son 4.000 y el agua llega a 20.000, asi que el mar se acababa en un canto a
; cuatro kilometros. Desde cubierta el horizonte esta a 5 km, pero se deja igual que las camaras
; del barco para que no haya dos mares distintos segun desde donde mires.
[node name="Camera3D" type="Camera3D" parent="CameraPivot"]
current = false
far = 25000.0

[node name="InteractRay" type="RayCast3D" parent="CameraPivot/Camera3D"]
target_position = Vector3(0, 0, -3)
collision_mask = 6
