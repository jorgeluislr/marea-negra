; ── El enemigo ───────────────────────────────────────────────────────────────
; Va aqui y no dentro del `.glb` ni clavado como nodo suelto: quien manda un barco no lo decide
; el barco. `GestorBarcos` instancia el del jugador y le pone el teclado; esto instancia los
; enemigos y les pone un `CapitanIA`. Son la misma operacion para los dos bandos.
;
; A 220 m: por encima de los 260 de `distancia_barlovento` el capitan se iria primero a ganar
; el barlovento y el encuentro tardaria un minuto en empezar. A esta distancia entra ya a
; cerrar, que es lo que se quiere para probar.
[node name="Escuadra" type="Node3D" parent="." unique_id=91002002]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0, -10)
script = ExtResource("escuadra")
barco = ExtResource("13")
cuantos = 1
bando = "enemigo"
pericia = 1.0
distancia = 220.0
demora = 45.0

; ── Los dos barcos mandados por IA ───────────────────────────────────────────
; El enemigo lo lleva `Escuadra`; a TU balandra le pone capitan este nodo, asi que el duelo se
; ve entero desde la camara de siempre sin tocar una tecla. El mando del teclado sigue puesto:
; si lo usas, tus ordenes y las del capitan se pisan.
[node name="PilotoAutomatico" type="Node" parent="." unique_id=91002003]
script = ExtResource("piloto")
activo = true
bando = "jugador"
