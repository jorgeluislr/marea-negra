; Salida en mar abierto, 1,5 km al sur de Norman Island. En el origen del mundo (el Drake Channel)
; la costa de Tortola quedaba a 100 m: a escala 1/25 el canal mide unos 300 m y las pruebas de
; navegación acababan contra tierra (`ia` / "ciñendo, gana terreno a barlovento": 30 m → 3-11).
[node name="GestorBarcos" type="Node3D" parent="." unique_id=1258553189]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0, 1500)
script = ExtResource("8")
