[sub_resource type="Resource" id="Aparejo_foque"]
script = ExtResource("9")
; CADA barco necesita SU copia: el aparejo guarda estado (el angulo de trimado y el
; izado), y un sub-recurso de escena se COMPARTE entre instancias. Sin esto, al cambiar
; de barco con TAB y volver, la percha saltaba de golpe al angulo del barco anterior
; mientras el pano nacia sin trimar: la mayor se estiraba un 36 % de media.
resource_local_to_scene = true
driza_hueso = "driza_foque"
driza_recorrido = 7.722
izado_suavizado = 1.5

[sub_resource type="Resource" id="Aparejo_mayor"]
script = ExtResource("9")
; CADA barco necesita SU copia: el aparejo guarda estado (el angulo de trimado y el
; izado), y un sub-recurso de escena se COMPARTE entre instancias. Sin esto, al cambiar
; de barco con TAB y volver, la percha saltaba de golpe al angulo del barco anterior
; mientras el pano nacia sin trimar: la mayor se estiraba un 36 % de media.
resource_local_to_scene = true
; Dos cabos: la driza sube el pano y la del PICO lo tumba a la vez, girando sobre la garganta.
driza_hueso = "driza"
driza_recorrido = 6.929
pico_hueso = "driza_pico"
pico_recorrido = 5.494
pico_giro = 19.7
pico_eje = Vector3(0, 0, 1)
izado_suavizado = 1.5
; Trimado LENTO a proposito: a 1.8 el pano se estiraba un 9,95 % de media; a 0.4, un 1,87 %.
trimado_hueso = "vela"
trimado_angulo_max = 45.0
trimado_eje = Vector3(0, 1, 0)
trimado_invertir = true
trimado_suavizado = 0.4

