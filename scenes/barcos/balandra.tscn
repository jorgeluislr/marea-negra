[node name="Modelo" parent="." index="1"]
transform = Transform3D(0, 0, -1, 0, 1, 0, 1, 0, 0, 0, 0, 0)
; La balandra NO lleva vela de shader: sus tres telas (foque, mayor y bandera) son fisicas y
; TelaFisica oculta la malla de autor para poner el SoftBody en su sitio. Los ajustes de
; shader que llegaron a estar aqui, MEDIDOS sobre este modelo, por si algun dia una tela suya
; vuelve al shader (mastil y perchas van en el espacio LOCAL de la malla):
;   amplitud 0.4  hinchado 0.9  frecuencia 3.0  velocidad 2.0  flameo 0.3  flameo_base 0.04
;   mastil_base (0.1384, 9.5494, 0)  mastil_eje (-0.1645, -0.9864, 0)  mastil_radio 0.107
;   perchas_a (-0.9144, 2.5, 0) y (0.0612, 8.35, 0)
;   perchas_b (6.0497, 3.1464, 0) y (3.872, 10.1272, 0)   perchas_radio 0.062

