[sub_resource type="Resource" id="Aparejo_vela"]
script = ExtResource("4")
; CADA barco necesita SU copia: el aparejo guarda estado (el angulo de trimado y el
; izado), y un sub-recurso de escena se COMPARTE entre instancias. Sin esto, al cambiar
; de barco con TAB y volver, la percha saltaba de golpe al angulo del barco anterior
; mientras el pano nacia sin trimar: la mayor se estiraba un 36 % de media.
resource_local_to_scene = true
; Los valores medidos de la lancha, que es de donde salen los tres cascos de una pieza.
driza_hueso = "driza"
driza_recorrido = 0.77
izado_suavizado = 2.5
trimado_hueso = "vela"
trimado_angulo_max = 10.0
trimado_suavizado = 4.0

[node name="Lancha" unique_id=1141170813 instance=ExtResource("1")]
velocidad_max = 10.0
aceleracion = 2.0
empuje_delantera = 0.3
empuje_trasera = 0.7
nombre = "Lancha"
recorte_radio = Vector2(0.8, 2)

[node name="CollisionShape3D" parent="." index="0"]
transform = Transform3D(0.5478693, 0, 0, 0, 2.645771, 0, 0, 0, 1, 0, 0.11124796, 0)

[node name="Modelo" parent="." index="1"]
transform = Transform3D(0, 0, -2.5, 0, 2.5, 0, 2.5, 0, 0, 0, 0, 0)

